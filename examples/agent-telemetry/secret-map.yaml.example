# The one file in this example that references a secret — and it does not contain one.
#
#   cp secret-map.yaml.example secret-map.yaml
#   chmod 600 secret-map.yaml
#
# The credential is a dedicated OpenObserve user with the read-only role, and it is NOT the ingest
# token. The ingest token lives in OTEL_EXPORTER_OTLP_HEADERS, belongs to a different user, and
# never leaves that header. Creating a second user is the whole isolation story: revoking search
# does not stop telemetry arriving, and a leaked search credential cannot write a record.
#
# The binding is what makes the credential unleakable to the guest. The component never sets an
# `authorization` header — the host rejects one from a guest by construction — and the broker's
# native HTTP engine injects Basic only for a destination inside this binding.
apiVersion: dekopon.dev/secret-map/v1alpha1
mapRevision: agent-telemetry-2026-09
secrets:
  - drn: drn:com.xrl:secret:home:openobserve/search-password
    source:
      kind: onePasswordConnect
      endpoint: https://connect.internal
      tokenFile: /run/dekopon-bootstrap/onepassword-token
      vault: vlt_dekopon
      item: itm_openobserve_search
      field: password
      timeoutMs: 10000
    projection:
      format: utf8
    bindings:
      # One binding per capability id, because `allowedPaths` and `maxInjections` differ with the
      # plan. `maxInjections` may not exceed the constraint set's `maxRequests`.
      - id: openobserve-search-agent-stats
        capability: openobserve.agent-stats
        sink: httpBasic
        basicUsername: dekopon-reader@rpi.lan
        allowedHosts: ["rpi.lan:5080"]
        allowedMethods: [POST]
        allowedPaths:
          - match: segmentPrefix
            path: /openobserve/api/default/_search
        # `?type=traces|logs` is a query, and the signal is how the store picks a stream.
        allowQuery: true
        maxInjections: 3
      - id: openobserve-search-broker-providers
        capability: openobserve.broker-providers
        sink: httpBasic
        basicUsername: dekopon-reader@rpi.lan
        allowedHosts: ["rpi.lan:5080"]
        allowedMethods: [POST]
        allowedPaths:
          - match: segmentPrefix
            path: /openobserve/api/default/_search
        allowQuery: true
        maxInjections: 2
      - id: openobserve-search-broker-usage
        capability: openobserve.broker-usage
        sink: httpBasic
        basicUsername: dekopon-reader@rpi.lan
        allowedHosts: ["rpi.lan:5080"]
        allowedMethods: [POST]
        allowedPaths:
          - match: segmentPrefix
            path: /openobserve/api/default/_search
        allowQuery: true
        maxInjections: 1
      - id: openobserve-search-trace
        capability: openobserve.trace
        sink: httpBasic
        basicUsername: dekopon-reader@rpi.lan
        allowedHosts: ["rpi.lan:5080"]
        allowedMethods: [POST]
        allowedPaths:
          - match: segmentPrefix
            path: /openobserve/api/default/_search
        allowQuery: true
        maxInjections: 1
      - id: openobserve-search-raw
        capability: openobserve.search
        sink: httpBasic
        basicUsername: dekopon-reader@rpi.lan
        allowedHosts: ["rpi.lan:5080"]
        allowedMethods: [POST]
        allowedPaths:
          - match: segmentPrefix
            path: /openobserve/api/default/_search
        allowQuery: true
        maxInjections: 1
