{
  "apiVersion": "dekopon.dev/provider/v1alpha1",
  "id": "openobserve",
  "description": "Reads configured OpenObserve telemetry with bounded generated queries",
  "capabilities": [
    {
      "id": "openobserve.trace",
      "description": "Projected trace spans without conversation events",
      "effect": "read-only",
      "risk": "Low",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "format": {
            "default": "json",
            "description": "One JSON object or a fixed-width table; both carry truncation information.",
            "enum": [
              "json",
              "table"
            ],
            "type": "string"
          },
          "limit": {
            "default": 100,
            "maximum": 500,
            "minimum": 1,
            "type": "integer"
          },
          "maxOutputBytes": {
            "default": 65536,
            "description": "Fit the result under this many bytes; the grant's ceiling is authoritative.",
            "maximum": 1048576,
            "minimum": 1024,
            "type": "integer"
          },
          "sinceSeconds": {
            "description": "How far back to look, in seconds; at most 24 hours.",
            "maximum": 86400,
            "minimum": 1,
            "type": "integer"
          },
          "traceId": {
            "maxLength": 32,
            "minLength": 32,
            "pattern": "^[0-9a-fA-F]{32}$",
            "type": "string"
          }
        },
        "required": [
          "traceId",
          "sinceSeconds"
        ],
        "type": "object"
      }
    },
    {
      "id": "openobserve.agent-stats",
      "description": "One agent's fixed five-minute sessions, turns, and decisions",
      "effect": "read-only",
      "risk": "Low",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "agent": {
            "description": "Cedar cannot compare the named agent against context.agent; a grant can name any agent.",
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_-]+$",
            "type": "string"
          },
          "format": {
            "default": "json",
            "description": "One JSON object or a fixed-width table; both carry truncation information.",
            "enum": [
              "json",
              "table"
            ],
            "type": "string"
          },
          "maxOutputBytes": {
            "default": 65536,
            "description": "Fit the result under this many bytes; the grant's ceiling is authoritative.",
            "maximum": 1048576,
            "minimum": 1024,
            "type": "integer"
          }
        },
        "required": [
          "agent"
        ],
        "type": "object"
      }
    },
    {
      "id": "openobserve.broker-providers",
      "description": "Broker boot and loaded providers within 24 hours",
      "effect": "read-only",
      "risk": "Low",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "format": {
            "default": "json",
            "description": "One JSON object or a fixed-width table; both carry truncation information.",
            "enum": [
              "json",
              "table"
            ],
            "type": "string"
          },
          "maxOutputBytes": {
            "default": 65536,
            "description": "Fit the result under this many bytes; the grant's ceiling is authoritative.",
            "maximum": 1048576,
            "minimum": 1024,
            "type": "integer"
          },
          "sinceSeconds": {
            "description": "How far back to look, in seconds; at most 24 hours.",
            "maximum": 86400,
            "minimum": 1,
            "type": "integer"
          },
          "view": {
            "enum": [
              "providers"
            ],
            "type": "string"
          }
        },
        "required": [
          "view",
          "sinceSeconds"
        ],
        "type": "object"
      }
    },
    {
      "id": "openobserve.broker-usage",
      "description": "Five-minute broker usage or denials without per-actor groups",
      "effect": "read-only",
      "risk": "Low",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "by": {
            "default": "provider",
            "enum": [
              "provider",
              "capability"
            ],
            "type": "string"
          },
          "format": {
            "default": "json",
            "description": "One JSON object or a fixed-width table; both carry truncation information.",
            "enum": [
              "json",
              "table"
            ],
            "type": "string"
          },
          "limit": {
            "default": 20,
            "maximum": 50,
            "minimum": 1,
            "type": "integer"
          },
          "maxOutputBytes": {
            "default": 65536,
            "description": "Fit the result under this many bytes; the grant's ceiling is authoritative.",
            "maximum": 1048576,
            "minimum": 1024,
            "type": "integer"
          },
          "view": {
            "enum": [
              "usage",
              "denials"
            ],
            "type": "string"
          }
        },
        "required": [
          "view"
        ],
        "type": "object"
      }
    }
  ],
  "commandWords": [
    "openobserve",
    "agent",
    "broker"
  ]
}
